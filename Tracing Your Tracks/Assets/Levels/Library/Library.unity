    - target: {fileID: 2997701947782708253, guid: e16bce84171832e45a02c038e842c326, type: 3}
      propertyPath: lines.Array.data[0].text
      value: 'A soggy picture book... it looks like it was turned in recently. Let''s
        see, the stamp card is kind of smudged, but it was turned in last night at
        around 9 pm. '
      objectReference: {fileID: 0}
    - target: {fileID: 2997701947782708253, guid: e16bce84171832e45a02c038e842c326, type: 3}
      propertyPath: lines.Array.data[1].text
      value: 'Wait a minute! This was around the time of the theft! The thieves had
        to have checked this out! . . . Argh! The names have been washed off! . .
        . Guess I haven''t solved the mystery yet. '
      objectReference: {fileID: 0}
    - target: {fileID: 2997701947782708253, guid: e16bce84171832e45a02c038e842c326, type: 3}
      propertyPath: lines.Array.data[0].speaker
      value: '*Thinking*'
